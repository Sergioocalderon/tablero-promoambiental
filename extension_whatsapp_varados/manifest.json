{
  "manifest_version": 3,
  "name": "Reportes WhatsApp a Varados",
  "version": "1.1.1",
  "description": "Lee los reportes del radio operador en el grupo de WhatsApp Web y los registra solos en la hoja de Varados.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Reportes WhatsApp a Varados", "default_popup": "options.html" }
}
