def seleccionar_moviles(
    devices: list[dict],
) -> list[dict]:

    ordenados = sorted(
        devices,
        key=lambda d: limpiar(d.get("name")),
    )

    print()
    print("=" * 100)
    print("MÓVILES")
    print("=" * 100)

    print("0. TODOS")

    for i, d in enumerate(ordenados, start=1):

        movil = limpiar(d.get("name"))
        placa = limpiar(d.get("licensePlate"))

        print(
            f"{i}. {movil:<20} {placa}"
        )

    entrada = input(
        "\nSeleccione móviles "
        "(0/ENTER = TODOS, varios: 1,3,5): "
    ).strip()

    if entrada in {"", "0"}:
        return ordenados

    indices = []

    for parte in entrada.split(","):

        parte = parte.strip()

        if not parte.isdigit():
            continue

        idx = int(parte)

        if 1 <= idx <= len(ordenados):
            indices.append(idx - 1)

    if not indices:
        return ordenados

    return [
        ordenados[i]
        for i in indices
    ]


# =============================================================================
# RESOLUCIÓN DE METADATOS
# =============================================================================

def resolver_empresa_device(
    api,
    device_id: str,
    cache: dict[str, set[str]],
) -> str:

    encontradas = []

    for nombre, gid in EMPRESAS.items():

        if gid not in cache:
            cache[gid] = ids_devices_grupo(
                api,
                gid,
            )

        if device_id in cache[gid]:
            encontradas.append(nombre)

    # Preferir empresa específica sobre el grupo padre *Promoambiental
    especificas = [
        x
        for x in encontradas
        if not x.startswith("*")
    ]

    if especificas:
        return " | ".join(
            sorted(set(especificas))
        )

    return " | ".join(
        sorted(set(encontradas))
    )


def resolver_marca_modelo_device(
    api,
    device_id: str,
    cache: dict[str, set[str]],
) -> str:

    encontradas = []

    for nombre, gid in MARCA_MODELO.items():

        if gid not in cache:
            cache[gid] = ids_devices_grupo(
                api,
                gid,
            )

        if device_id in cache[gid]:
            encontradas.append(
                nombre_base_marca_modelo(nombre)
            )

    return " | ".join(
        sorted(set(encontradas))
    )


# =============================================================================
# ODÓMETRO
# =============================================================================

def consultar_ultimo_odometro(
    api,
    device_id: str,
) -> tuple[float | None, str, bool]:

    ahora_local = datetime.now(
        TZ_BOGOTA
    )

    inicio_hoy_local = ahora_local.replace(
        hour=0,
        minute=0,
        second=0,
        microsecond=0,
    )

    inicio_hoy_utc = inicio_hoy_local.astimezone(
        timezone.utc
    )

    ahora_utc = ahora_local.astimezone(
        timezone.utc
    )

    # Primero: hoy
    datos_hoy = api.get(
        "StatusData",
        search={
            "deviceSearch": {
                "id": device_id,
            },
            "diagnosticSearch": {
                "id": DIAGNOSTIC_ODOMETER_ID,
            },
            "fromDate": inicio_hoy_utc,
            "toDate": ahora_utc,
        },
        resultsLimit=50000,
    )

    if datos_hoy:

        ultimo = max(
            datos_hoy,
            key=lambda x: str(
                x.get("dateTime", "")
            ),
        )

        km = (
            float(ultimo.get("data"))
            / 1000.0
        )

        return (
            km,
            fecha_legible(
                ultimo.get("dateTime")
            ),
            True,
        )

    # Si no hay hoy, buscar último histórico
    desde_historico = (
        ahora_utc
        - timedelta(
            days=LOOKBACK_DAYS
        )
    )

    datos = api.get(
        "StatusData",
        search={
            "deviceSearch": {
                "id": device_id,
            },
            "diagnosticSearch": {
                "id": DIAGNOSTIC_ODOMETER_ID,
            },
            "fromDate": desde_historico,
            "toDate": ahora_utc,
        },
        resultsLimit=50000,
    )

    if not datos:
        return (
            None,
            "",
            False,
        )

    ultimo = max(
        datos,
        key=lambda x: str(
            x.get("dateTime", "")
        ),
    )

    km = (
        float(ultimo.get("data"))
        / 1000.0
    )

    return (
        km,
        fecha_legible(
            ultimo.get("dateTime")
        ),
        False,
    )


# =============================================================================
# CONSULTA FINAL
# =============================================================================

def consultar_resultados(
    api,
    devices: list[dict],
) -> pd.DataFrame:

    cache_membership: dict[
        str,
        set[str],
    ] = {}

    filas = []

    total = len(devices)

    print()
    print("=" * 120)
    print("CONSULTANDO ÚLTIMO ODÓMETRO")
    print("=" * 120)

    for i, d in enumerate(
        devices,
        start=1,
    ):

        id_device = limpiar(
            d.get("id")
        )

        movil = limpiar(
            d.get("name")
        )

        placa = limpiar(
            d.get("licensePlate")
        )

        print(
            f"[{i:02d}/{total:02d}] "
            f"{movil:<20}",
            end=" ... ",
            flush=True,
        )

        try:

            km, fecha, hoy = (
                consultar_ultimo_odometro(
                    api,
                    id_device,
                )
            )

            empresa = resolver_empresa_device(
                api,
                id_device,
                cache_membership,
            )

            marca_modelo = (
                resolver_marca_modelo_device(
                    api,
                    id_device,
                    cache_membership,
                )
            )

            if km is None:

                print("SIN DATO")

            elif hoy:

                print(
                    f"{km:,.1f} km "
                    f"| HOY {fecha}"
                )

            else:

                print(
                    f"{km:,.1f} km "
                    f"| ÚLTIMO HISTÓRICO {fecha}"
                )

            filas.append(
                {
                    "Móvil": movil,
                    "Placa": placa,
                    "Empresa": empresa,
                    "Marca / Modelo": marca_modelo,
                    "Odómetro km": km,
                    "Última lectura": fecha,
                    "Lectura de hoy": (
                        "SI"
                        if hoy
                        else "NO"
                    ),
                    "id_device": id_device,
                }
            )

        except Exception as exc:

            print(
                f"ERROR: {exc}"
            )

            filas.append(
                {
                    "Móvil": movil,
                    "Placa": placa,
                    "Empresa": "",
                    "Marca / Modelo": "",
                    "Odómetro km": None,
                    "Última lectura": "",
                    "Lectura de hoy": "ERROR",
                    "id_device": id_device,
                }
            )

    return pd.DataFrame(
        filas
    )


# =============================================================================
# RESULTADO
# =============================================================================

def mostrar_resultado(
    df: pd.DataFrame,
) -> None:

    print()
    print("=" * 140)
    print("RESULTADO FINAL")
    print("=" * 140)

    if df.empty:
        print("Sin resultados.")
        return

    vista = df.copy()

    vista["Odómetro km"] = (
        vista[
            "Odómetro km"
        ]
        .apply(
            lambda x: (
                f"{x:,.1f}"
                if pd.notna(x)
                else "SIN DATO"
            )
        )
    )

    columnas = [
        "Móvil",
        "Placa",
        "Empresa",
        "Marca / Modelo",
        "Odómetro km",
        "Última lectura",
        "Lectura de hoy",
    ]

    print(
        vista[
            columnas
        ].to_string(
            index=False
        )
    )

    print()

    print(
        f"TOTAL: {len(df)}"
    )

    print(
        "LECTURA DE HOY: "
        f"{(df['Lectura de hoy'] == 'SI').sum()}"
    )

    print(
        "LECTURA HISTÓRICA: "
        f"{(df['Lectura de hoy'] == 'NO').sum()}"
    )

    print(
        "SIN DATO / ERROR: "
        f"{df['Odómetro km'].isna().sum()}"
    )


# =============================================================================
# EXCEL
# =============================================================================

def exportar_excel(
    df: pd.DataFrame,
) -> Path:

    timestamp = datetime.now(
        TZ_BOGOTA
    ).strftime(
        "%Y%m%d_%H%M%S"
    )

    ruta = (
        OUTPUT_DIR
        / f"ultimo_odometro_geotab_{timestamp}.xlsx"
    )

    with pd.ExcelWriter(
        ruta,
        engine="openpyxl",
    ) as writer:

        df.to_excel(
            writer,
            index=False,
            sheet_name="Último Odómetro",
        )

        ws = writer.book[
            "Último Odómetro"
        ]

        ws.freeze_panes = "A2"
        ws.auto_filter.ref = ws.dimensions

        for columna in ws.columns:

            letra = (
                columna[0]
                .column_letter
            )

            ancho = max(
                (
                    len(str(celda.value))
                    for celda in columna
                    if celda.value is not None
                ),
                default=0,
            )

            ws.column_dimensions[
                letra
            ].width = min(
                ancho + 3,
                45,
            )

        headers = {
            c.value: c.column
            for c in ws[1]
        }

        col_km = headers.get(
            "Odómetro km"
        )

        if col_km:

            for fila in range(
                2,
                ws.max_row + 1,
            ):

                ws.cell(
                    fila,
                    col_km,
                ).number_format = (
                    '#,##0.0'
                )

    return ruta


