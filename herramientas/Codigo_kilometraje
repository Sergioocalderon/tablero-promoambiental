# =============================================================================
# UTILIDADES
# =============================================================================

def limpiar(valor: Any) -> str:
    if valor is None:
        return ""
    return str(valor).strip()


def fecha_bogota(valor: Any) -> datetime | None:
    if not valor:
        return None

    try:
        if isinstance(valor, datetime):
            dt = valor
        else:
            dt = datetime.fromisoformat(
                str(valor).replace("Z", "+00:00")
            )

        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)

        return dt.astimezone(TZ_BOGOTA)

    except Exception:
        return None


def fecha_legible(valor: Any) -> str:
    dt = fecha_bogota(valor)

    if dt is None:
        return ""

    return dt.strftime("%d/%m/%Y %H:%M:%S")


def es_hoy(valor: Any) -> bool:
    dt = fecha_bogota(valor)

    if dt is None:
        return False

    return dt.date() == datetime.now(TZ_BOGOTA).date()


