def conectar_geotab():
    from App.geotab.client import GeotabClient

    print()
    print("Conectando con Geotab...")

    client = GeotabClient.from_settings()
    api = client.authenticate()

    print("Conexión correcta.")

    return api


def obtener_devices(api) -> list[dict]:
    return api.get(
        "Device",
        resultsLimit=50000,
    )


def obtener_devices_grupo(
    api,
    group_id: str,
) -> list[dict]:

    return api.get(
        "Device",
        search={
            "groups": [
                {"id": group_id}
            ]
        },
        resultsLimit=50000,
    )


def ids_devices_grupo(
    api,
    group_id: str,
) -> set[str]:

    return {
        limpiar(d.get("id"))
        for d in obtener_devices_grupo(api, group_id)
        if limpiar(d.get("id"))
    }


# =============================================================================
# SELECTORES
# =============================================================================

def seleccionar_opciones(
    titulo: str,
    opciones: list[str],
) -> list[str]:

    print()
    print("=" * 90)
    print(titulo.upper())
    print("=" * 90)

    print("0. TODOS")

    for i, opcion in enumerate(opciones, start=1):
        print(f"{i}. {opcion}")

    entrada = input(
        f"\nSeleccione {titulo.lower()} "
        "(0/ENTER = TODOS, varios: 1,3): "
    ).strip()

    if entrada in {"", "0"}:
        return []

    elegidos = []

    for parte in entrada.split(","):

        parte = parte.strip()

        if not parte.isdigit():
            continue

        idx = int(parte)

        if 1 <= idx <= len(opciones):
            elegidos.append(opciones[idx - 1])

    return elegidos


# =============================================================================
# FILTRO EMPRESA
# =============================================================================

def filtrar_por_empresa(
    api,
    devices: list[dict],
) -> tuple[list[dict], list[str]]:

    opciones = list(EMPRESAS.keys())

    elegidas = seleccionar_opciones(
        "Empresa",
        opciones,
    )

    if not elegidas:
        return devices, []

    ids_permitidos = set()

    for empresa in elegidas:

        print(
            f"Resolviendo empresa: {empresa}..."
        )

        ids_permitidos |= ids_devices_grupo(
            api,
            EMPRESAS[empresa],
        )

    filtrados = [
        d
        for d in devices
        if limpiar(d.get("id")) in ids_permitidos
    ]

    return filtrados, elegidas


# =============================================================================
# FILTRO MARCA / MODELO
# =============================================================================

def nombre_base_marca_modelo(nombre: str) -> str:
    """
    Quita [1], [2], etc. de grupos duplicados equivalentes.
    """
    return nombre.split("[")[0].strip()


def opciones_marca_modelo() -> list[str]:
    nombres = {
        nombre_base_marca_modelo(nombre)
        for nombre in MARCA_MODELO
    }

    return sorted(nombres)


def grupos_de_marca_modelo(
    nombre_visible: str,
) -> list[str]:

    grupos = []

    for nombre, gid in MARCA_MODELO.items():

        if (
            nombre_base_marca_modelo(nombre)
            == nombre_visible
        ):
            grupos.append(gid)

    return grupos


def filtrar_por_marca_modelo(
    api,
    devices: list[dict],
) -> tuple[list[dict], list[str]]:

    opciones = opciones_marca_modelo()

    elegidas = seleccionar_opciones(
        "Marca / Modelo",
        opciones,
    )

    if not elegidas:
        return devices, []

    ids_permitidos = set()

    for marca_modelo in elegidas:

        print(
            f"Resolviendo marca / modelo: "
            f"{marca_modelo}..."
        )

        for gid in grupos_de_marca_modelo(
            marca_modelo
        ):
            ids_permitidos |= ids_devices_grupo(
                api,
                gid,
            )

    filtrados = [
        d
        for d in devices
        if limpiar(d.get("id")) in ids_permitidos
    ]

    return filtrados, elegidas


# =============================================================================
