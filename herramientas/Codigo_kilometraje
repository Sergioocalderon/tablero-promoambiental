def ejecutar() -> None:

    print()
    print("=" * 110)
    print(
        "HERRAMIENTA — ÚLTIMO ODÓMETRO GEOTAB"
    )
    print("=" * 110)

    print(
        "Fuente: 100% Geotab"
    )

    print(
        "Diagnóstico: "
        "DiagnosticOdometerId"
    )

    print(
        "Filtros: "
        "Empresa → Marca / Modelo → Móvil"
    )

    print(
        "Modo: SOLO LECTURA"
    )

    api = conectar_geotab()

    print()
    print(
        "Cargando vehículos Geotab..."
    )

    devices = obtener_devices(
        api
    )

    print(
        f"Vehículos encontrados: "
        f"{len(devices)}"
    )

    devices, empresas_elegidas = (
        filtrar_por_empresa(
            api,
            devices,
        )
    )

    print(
        f"Después de empresa: "
        f"{len(devices)}"
    )

    if not devices:
        print(
            "No hay vehículos "
            "para esa empresa."
        )
        return

    devices, marcas_elegidas = (
        filtrar_por_marca_modelo(
            api,
            devices,
        )
    )

    print(
        f"Después de marca/modelo: "
        f"{len(devices)}"
    )

    if not devices:
        print(
            "No hay vehículos "
            "para esa selección."
        )
        return

    devices = seleccionar_moviles(
        devices
    )

    if not devices:
        print(
            "No se seleccionaron móviles."
        )
        return

    resultados = consultar_resultados(
        api,
        devices,
    )

    mostrar_resultado(
        resultados
    )

    respuesta = input(
        "\n¿Exportar a Excel? [S/N]: "
    ).strip().upper()

    if respuesta in {
        "S",
        "SI",
        "SÍ",
    }:

        ruta = exportar_excel(
            resultados
        )

        print()
        print(
            "Archivo generado:"
        )

        print(
            ruta
        )


if __name__ == "__main__":
    ejecutar()